{
  "entities": {
    "TeacherProfile": {
      "title": "TeacherProfile",
      "description": "Represents an Algerian teacher's private profile document.",
      "type": "object",
      "properties": {
        "firstName": { "type": "string", "description": "Teacher's first name." },
        "lastName": { "type": "string", "description": "Teacher's last name." },
        "email": { "type": "string", "format": "email", "description": "Teacher's email address." },
        "schoolName": { "type": "string", "description": "Optional school or establishment name." },
        "educationalLevel": { "type": "string", "description": "Educational cycle (Primaire, CEM, Lycée)." },
        "accountCreationDate": { "type": "string", "format": "date-time", "description": "Account creation timestamp." },
        "wilaya": { "type": "string", "description": "Algerian Wilaya." },
        "subject": { "type": "string", "description": "Teaching subject." }
      },
      "required": ["firstName", "lastName", "email", "educationalLevel"]
    },
    "Classroom": {
      "title": "Classroom",
      "description": "A classroom managed by the teacher.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Classroom name." },
        "level": { "type": "string", "description": "Academic level." },
        "roomNumber": { "type": "string", "description": "Room identifier." },
        "studentCount": { "type": "integer", "description": "Count of students." },
        "averageScore": { "type": "number", "description": "Current class average out of 20." }
      },
      "required": ["name", "level"]
    },
    "Student": {
      "title": "Student",
      "description": "A student in the teacher's classroom.",
      "type": "object",
      "properties": {
        "classroomId": { "type": "string", "description": "Associated classroom ID." },
        "classroomName": { "type": "string", "description": "Associated classroom name." },
        "firstName": { "type": "string", "description": "Student's first name." },
        "lastName": { "type": "string", "description": "Student's last name." },
        "gender": { "type": "string", "enum": ["MALE", "FEMALE"], "description": "Student gender." },
        "registrationNumber": { "type": "string", "description": "School registration number." },
        "parentPhone": { "type": "string", "description": "Parent phone number." },
        "termAverage": { "type": "number", "description": "Term average score." },
        "totalAbsences": { "type": "integer", "description": "Total absences." },
        "participationStars": { "type": "integer", "description": "Participation stars." },
        "notes": { "type": "string", "description": "Pedagogical notes." }
      },
      "required": ["classroomId", "firstName", "lastName", "gender", "registrationNumber"]
    }
  },
  "firestore": {
    "/teachers/{teacherUid}": {
      "schema": "TeacherProfile",
      "description": "Private profile document for each teacher."
    },
    "/teachers/{teacherUid}/classrooms/{classroomId}": {
      "schema": "Classroom",
      "description": "Classrooms managed by this specific teacher."
    },
    "/teachers/{teacherUid}/students/{studentId}": {
      "schema": "Student",
      "description": "Students managed by this specific teacher."
    }
  }
}
